# ═══════════════════════════════════════════════════════════════════════════════
# Century Road – PRODUCTION settings
#
# Read by compose-prod.yml and by nothing else:
#     docker compose -f compose-prod.yml up -d
#
# Copy this file to .env on the server and fill in your values. .env is gitignored and must
# NEVER be committed. Development has its own file, .env.dev (see .env.dev.example), read by
# compose-dev.yml - the two never overlap, so a value set for one cannot leak into the other.
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# The database is not published anywhere in production: only the services reach it.
POSTGRES_DB=centuryroad
POSTGRES_USER=centuryroad
POSTGRES_PASSWORD=change-me                        # required

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-min-32-chars  # required, 32+ bytes once base64-decoded
JWT_EXPIRATION_MS=86400000                            # 24 h in milliseconds

# ── Ports the gateway and auth-service listen on ──────────────────────────────
# Inside the Compose network only: nothing publishes them. The proxy, the gateway, Prometheus
# and every healthcheck all read these two variables, so they are changed here and nowhere else.
GATEWAY_PORT=12129                                 # required
AUTH_PORT=12130                                    # required

# ── Ports published on the host ───────────────────────────────────────────────
# Prometheus and Grafana are bound to the host's loopback (127.0.0.1) and reached from
# elsewhere through an SSH tunnel, never directly - see README. Only the host side moves.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# The proxy is the only public entry. Leave these at 80/443 unless a router or firewall
# forwards the public 80/443 to them: the certificate challenge arrives on 80/443
# whatever is set here, and a domain that cannot be reached there gets no certificate.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ── Reverse proxy / TLS ───────────────────────────────────────────────────────
# PUBLIC_DOMAIN must already resolve to this host, or Caddy cannot obtain a certificate.
PUBLIC_DOMAIN=api.yourdomain.example               # required
# Seconds a browser will refuse plain HTTP for this host. Kept low on purpose while
# HTTPS is new: raise to 31536000 (one year) once it has been stable for a while.
HSTS_MAX_AGE=300

# ── Frontend ──────────────────────────────────────────────────────────────────
# The exact origin the frontend is served from - scheme, host and port, no trailing
# slash. Anything not listed here is refused by the browser before reaching the API.
FRONTEND_ORIGIN=https://app.yourdomain.example     # required

# ── First administrator (bootstrap) ───────────────────────────────────────────
# Set BOTH only for the very first start against an empty database: creating a user
# requires an admin token, so without this there is no way to get the first one in.
# The mechanism is inert on a database that already has users. Clear both and restart
# once you have logged in - see README, "First administrator".
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Wikipedia (history-service) ───────────────────────────────────────────────
# Wikimedia's User-Agent policy asks every client to say who can be reached if it misbehaves,
# and blocks those that do not "without notice". A URL is enough - this repository's page is
# a good choice, and holds no personal data. An address works too. No default on purpose:
# history-service refuses to start without one.
WIKIMEDIA_CONTACT=https://github.com/F3rren/century-road-backend        # required

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me                         # required
