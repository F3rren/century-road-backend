# =============================================================================
# Century Road - production settings example for Docker Compose on the VPS
#
# Copy to .env on the server and replace the placeholder values.
# Never commit .env. Development uses .env.dev with compose-dev.yml.
#
# Start production with:
# docker compose -f compose-prod.yml up -d
#
# This file is not used to configure Railway services.
# =============================================================================

# PostgreSQL
# One PostgreSQL container hosts the auth and history databases.
# The database port is not published on the host in production.
POSTGRES_DB=centuryroad
POSTGRES_USER=centuryroad

# Required: replace with a strong production password.
POSTGRES_PASSWORD=change-me

# JWT
# Required: generate a new secret, for example with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-min-32-chars

# Token lifetime: 24 hours in milliseconds.
JWT_EXPIRATION_MS=86400000

# Internal service ports
# Compose must pass these ports to the applications and use them in
# gateway routes, proxy configuration, monitoring and healthchecks.
GATEWAY_PORT=12129
AUTH_PORT=12130
HISTORY_PORT=12131

# Host-side monitoring ports
# Compose binds these to 127.0.0.1; use an SSH tunnel for remote access.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Public reverse-proxy ports
# Leave these at 80/443 unless public traffic is forwarded accordingly.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Reverse proxy and TLS
# Required: the domain must point to this VPS.
PUBLIC_DOMAIN=api.yourdomain.example

# Start with a short HSTS duration; increase it after HTTPS is stable.
HSTS_MAX_AGE=300

# Frontend
# Required: exact origin, including scheme and optional port; no trailing slash.
FRONTEND_ORIGIN=https://app.yourdomain.example

# First administrator
# Set both values for the first start against an empty users table.
# Clear both after bootstrapping the administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Wikipedia / history-service
# Required: a reachable contact URL or email address for this client.
WIKIMEDIA_CONTACT=https://github.com/F3rren/century-road-backend

# Grafana
GRAFANA_USER=admin

# Required: replace with a strong production password.
GRAFANA_PASSWORD=change-me

# Backups
# Store dumps outside the repository checkout.
BACKUP_DIR=/var/backups/century-road
BACKUP_RETENTION_DAYS=7
BACKUP_REMOTE_RETENTION_DAYS=30

# Set this to the name of an rclone remote configured separately.
RCLONE_REMOTE=change-me

# Alerting
# Incoming webhook for Grafana alerts and backup failure notifications.
ALERT_WEBHOOK_URL=change-me