# The only thing on this stack that faces the internet. It terminates TLS and hands
# plain HTTP to the gateway on the internal compose network, which is why the gateway
# no longer publishes a port of its own outside of dev.
#
# PUBLIC_DOMAIN must resolve to this host before the first start: Caddy obtains and
# renews the certificate automatically, and a domain that does not resolve yet simply
# fails the challenge.

{$PUBLIC_DOMAIN} {

	# The gateway serves its own actuator on the same port as the API, so without this
	# everything Prometheus scrapes (/actuator/prometheus, /actuator/metrics) would be
	# readable by anyone. Prometheus reaches the gateway over the internal network and
	# never comes through here. Only health stays public, for uptime checks and the
	# README's HSTS verification.
	@actuatorPrivate {
		path /actuator/*
		not path /actuator/health /actuator/health/*
	}
	handle @actuatorPrivate {
		respond 404
	}

	handle {
		reverse_proxy gateway:{$GATEWAY_PORT:8080} {
			# Set, never append. Caddy's default is to append to whatever the caller sent,
			# which would let anyone put an address of their choosing at the front of the
			# list - and the login rate limiter downstream keys on exactly that address.
			# Overwriting is what makes server.forward-headers-strategy safe to enable.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}

			# The standard Forwarded header is not one of those: Caddy passes it on exactly as
			# the caller sent it, and Spring reads it in preference to X-Forwarded-For, so a
			# caller could still choose the address the rate limiter sees. Nothing here sets it,
			# so drop it. The gateway ignores it too (XForwardedOnlyHeaderTransformer), so
			# neither layer is the only thing standing in the way.
			header_up -Forwarded
		}
	}

	header {
		# HSTS only means anything over HTTPS, which is the only way into this block.
		# HSTS_MAX_AGE starts deliberately low: a browser that has seen this header
		# refuses plain HTTP for the whole window, so a broken certificate during the
		# first rollout would lock people out for as long as max-age says. Raise it to
		# 31536000 (one year) once HTTPS has been stable for a while.
		#
		# "preload" is left out on purpose. It is not just a longer max-age: it asks to
		# be baked into the browsers themselves, and getting back off that list takes
		# months. Add it only when every subdomain is permanently HTTPS.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:300}; includeSubDomains"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"

		# Nothing downstream needs to advertise what is running here.
		-Server

		# Set these once the service has answered, so they replace what it sent. Without
		# this, Caddy sets them before the reverse proxy runs, and the proxy then adds the
		# service's own next to them: auth-service sends an HSTS of one year on any request
		# it takes for secure, and the browser would see both. The -Server line above
		# already makes Caddy do this for the whole block, but that is a side effect of
		# deleting a header, and nobody removing the line should get a different result.
		# infra/caddy/headers_test.sh checks that.
		defer
	}
}
