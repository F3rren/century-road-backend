# ═══════════════════════════════════════════════════════════════════════════════
# Century Road – DEVELOPMENT settings
#
# Read by compose-dev.yml and by nothing else:
#     docker compose --env-file .env.dev -f compose-dev.yml up
#
# Copy this file to .env.dev and fill in the three "change-me" values. .env.dev is
# gitignored. These are throwaway development secrets: do not reuse the production ones,
# which live in .env and are read only by compose-prod.yml.
#
# The ports are not here: compose-dev.yml fixes them (gateway 8080, auth-service 8081,
# history-service 8082), so nothing in any .env can move them.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Marker ────────────────────────────────────────────────────────────────────
# compose-dev.yml refuses to start without this, so it can never run by accident on the
# production .env (which is what Compose reads when --env-file is forgotten). Leave it.
CENTURY_ROAD_ENV=dev

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=centuryroad
POSTGRES_USER=centuryroad
POSTGRES_PASSWORD=change-me                        # required

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me                               # required, 32+ bytes once base64-decoded
JWT_EXPIRATION_MS=86400000

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me                         # required

# ── A first administrator for the empty development database ──────────────────
# Set BOTH to be able to log in and try the admin routes straight away. Inert once the
# users table has anyone in it.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Optional: these have defaults in compose-dev.yml, uncomment only to change them ───
# The exact origin your frontend is served from. Vite's default port is the default here.
# FRONTEND_ORIGIN=http://localhost:5173
# Where Postgres is published on this machine, for psql and similar tools.
# DB_PORT=5433
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# Who Wikimedia can reach about this client (a URL or an address).
# WIKIMEDIA_CONTACT=https://github.com/F3rren/century-road-backend

# ── Running a service from your IDE instead of Docker ─────────────────────────
# The services read these from the environment. Point them at the published database:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/centuryroad
# SPRING_DATASOURCE_USERNAME=centuryroad
# SPRING_DATASOURCE_PASSWORD=<POSTGRES_PASSWORD above>
