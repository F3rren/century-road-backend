# Century Road - development environment example
#
# Copy to .env.dev, replace the required placeholders, and run:
# docker compose --env-file .env.dev -f compose-dev.yml up --build
#
# Never reuse production credentials in development.

CENTURY_ROAD_ENV=dev

# Required development database credentials.
POSTGRES_DB=centuryroad
POSTGRES_USER=centuryroad
POSTGRES_PASSWORD=change-me

# Required development JWT secret.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRATION_MS=86400000

# Required development Grafana credentials.
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Optional first-admin bootstrap: set both values together.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional Compose overrides.
# FRONTEND_ORIGIN=http://localhost:5173
# DB_PORT=5433
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# WIKIMEDIA_CONTACT=https://github.com/F3rren/century-road-backend