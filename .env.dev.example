# Century Road - development environment example
#
# Copy to .env.dev, replace the three required `change-me` values, and run:
# docker compose --env-file .env.dev -f compose-dev.yml up --build
#
# Never reuse production credentials in development: these are throwaway secrets for your own
# machine. .env.dev is gitignored and must never be committed; this file is the template.

# The marker compose-dev.yml looks for. Without it, Compose refuses to start rather than
# read the production .env by mistake.
CENTURY_ROAD_ENV=dev

# Required: development database credentials.
POSTGRES_DB=centuryroad
POSTGRES_USER=centuryroad
POSTGRES_PASSWORD=change-me

# Required: development JWT secret. It is base64-decoded and must be at least 32 bytes after
# decoding. Generate with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRATION_MS=86400000

# Required: development Grafana credentials.
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Required by the compose file, but a placeholder is fine: with this value Grafana alerts go
# nowhere. Put a Discord/Slack incoming webhook here to see them.
ALERT_WEBHOOK_URL=https://example.invalid/century-road-dev-alerts

# Optional first-admin bootstrap: set both values together (see README, "First administrator").
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional Compose overrides.
# FRONTEND_ORIGIN=http://localhost:5173
# DB_PORT=5433
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# WIKIMEDIA_CONTACT=https://github.com/F3rren/century-road-backend
